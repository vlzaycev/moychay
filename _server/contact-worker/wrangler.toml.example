# Copy to wrangler.toml before deploying (see TELEGRAM_INTEGRATION_TODO.md).
# Secrets are NOT stored here: set them with
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHAT_ID
#   npx wrangler secret put TURNSTILE_SECRET   (optional)
name = "teaphuket-contact"
main = "src/index.js"
compatibility_date = "2026-10-01"

# Same origin as the site: no CORS, nothing to configure in the browser
routes = [{ pattern = "teaphuket.com/api/contact", zone_name = "teaphuket.com" }]

# Do not keep request logs with personal data
[observability]
enabled = false

# 5 enquiries per minute per IP
[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 5, period = 60 }
