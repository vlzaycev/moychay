# Copy to wrangler.toml before deploying (see TELEGRAM_INTEGRATION_TODO.md).
# No secrets in this file. Set them only with `wrangler secret put` (stored encrypted by Cloudflare):
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHAT_ID
#   npx wrangler secret put TURNSTILE_SECRET
#   npx wrangler secret put HASH_SALT          # any long random string, e.g. `openssl rand -hex 32`
# Without any of them (or the bindings below) the Worker answers 503 and sends nothing.
name = "teaphuket-contact"
main = "src/index.js"
compatibility_date = "2026-10-01"

# Same origin as the site: no CORS needed in the browser
routes = [{ pattern = "teaphuket.com/api/contact", zone_name = "teaphuket.com" }]

# No request logs with personal data (the Worker itself logs only codes)
[observability]
enabled = false

# Rate limits counted by Cloudflare (free; period must be 10 or 60 seconds)
[[ratelimits]]
name = "RL_IP"            # per visitor (hashed IP): 5 enquiries per minute
namespace_id = "1001"
  [ratelimits.simple]
  limit = 5
  period = 60

[[ratelimits]]
name = "RL_GLOBAL"        # whole site: 30 enquiries per minute – caps a distributed flood
namespace_id = "1002"
  [ratelimits.simple]
  limit = 30
  period = 60

# Workers KV (free tier): daily cap per IP + duplicate suppression. Create once:
#   npx wrangler kv namespace create FORM_KV   → paste the id below
[[kv_namespaces]]
binding = "FORM_KV"
id = "<kv-namespace-id>"
